# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shelfie?retryWrites=true&w=majority
MONGODB_DB_NAME=shelfie

# Google Books API (optional, for higher rate limits)
GOOGLE_BOOKS_API_KEY=

# Application Settings
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=3600
FEED_RATE_LIMIT_SECONDS=3600

# Health Check Server
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
